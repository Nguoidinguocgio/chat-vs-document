{
  "name": "chat-vs-document-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "size": "size-limit",
    "dev:mock": "vite --mode mock",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/shared/api/schema.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.105.0",
    "dompurify": "^3.4.17",
    "markdown-it": "^14.3.3",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.3.1",
    "reka-ui": "^2.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@size-limit/file": "^11.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "eslint": "^9.12.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-vue": "^9.28.0",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.47",
    "size-limit": "^11.2.0",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.3",
    "vue-tsc": "^2.1.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}