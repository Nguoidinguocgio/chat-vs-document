# Backend
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/chatdoc
DB_USER=chatdoc
DB_PASSWORD=change-me
SESSION_IDLE_HOURS=8
# Cờ Secure của cookie sid. Trình duyệt vẫn nhận cookie Secure trên http://localhost; chỉ đặt false khi
# truy cập dev qua tên máy/IP không có HTTPS. Production luôn true.
SESSION_COOKIE_SECURE=true
APP_VERSION=0.1.0
# Số worker xử lý PDF song song (T08)
PROCESSING_WORKERS=2
# Bật /v3/api-docs để đối chiếu với contracts/openapi.yaml (chỉ dev/test)
API_DOCS_ENABLED=false
STORAGE_DIR=./storage
MAX_DOCS=20
MAX_FILE_MB=10
MAX_PAGES=100
# Embedding: bge-m3 qua Ollama (đa ngôn ngữ, 1024 chiều). Test/E2E dùng `fake`.
# EMBEDDING_DIM cố định từ migration V1 — đổi mô hình khác số chiều phải tạo lại cột và tính lại vector.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# LLM: Anthropic Claude. Để `fake` cho tới khi có LLM_API_KEY; đổi thành `anthropic` để gọi thật.
LLM_PROVIDER=fake
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
RETRIEVAL_TOP_K=8
# Phải hiệu chỉnh theo bge-m3 bằng DEP-002 (T20): câu lạc đề đo thử được ~0.29, sát ngưỡng.
RETRIEVAL_MIN_SCORE=0.30
LLM_FIRST_TOKEN_TIMEOUT_S=30
STREAM_STALL_SECONDS=31
# Độ dài tối đa câu trả lời (token); tiếng Việt tốn token hơn tiếng Anh.
LLM_MAX_TOKENS=1500
# Số luồng hỏi đáp đồng thời toàn hệ thống (vượt: chờ 10 s rồi báo rate_limited).
CHAT_MAX_CONCURRENT=20

# Frontend
VITE_POLL_FALLBACK=false
